{
  "currency": "GYD",
  "formulas": [
    {
      "id": "revenue_units",
      "formula": "units_sold * selling_price",
      "description": "Product revenue"
    },
    {
      "id": "revenue_services",
      "formula": "jobs_or_hours * average_price",
      "description": "Service revenue"
    },
    {
      "id": "gross_profit",
      "formula": "revenue - cost_of_goods_or_direct_costs"
    },
    {
      "id": "gross_margin_pct",
      "formula": "gross_profit / revenue * 100",
      "guard": "If revenue <= 0, return N/A"
    },
    {
      "id": "contribution_unit",
      "formula": "selling_price - variable_cost_per_unit"
    },
    {
      "id": "contribution_margin_ratio",
      "formula": "(revenue - total_variable_costs) / revenue",
      "guard": "If revenue <= 0, return N/A"
    },
    {
      "id": "break_even_units",
      "formula": "fixed_costs / contribution_per_unit",
      "guard": "If contribution_per_unit <= 0, flag infeasible"
    },
    {
      "id": "break_even_revenue",
      "formula": "fixed_costs / contribution_margin_ratio",
      "guard": "If contribution_margin_ratio <= 0, flag infeasible"
    },
    {
      "id": "employer_nis",
      "formula": "min(monthly_gross_salary, 280000) * 0.084",
      "valid_as_of": "2026-09-28",
      "source_id": "NIS"
    },
    {
      "id": "employee_nis",
      "formula": "min(monthly_gross_salary, 280000) * 0.056",
      "valid_as_of": "2026-09-28",
      "source_id": "NIS"
    },
    {
      "id": "closing_cash",
      "formula": "opening_cash + cash_inflows - cash_outflows"
    },
    {
      "id": "funding_gap",
      "formula": "startup_cash_need + abs(min(0, lowest_projected_closing_cash)) - confirmed_owner_cash"
    },
    {
      "id": "inventory_turnover",
      "formula": "annual_cogs / average_inventory",
      "guard": "If average_inventory <= 0, return N/A"
    },
    {
      "id": "receivable_days",
      "formula": "average_accounts_receivable / annual_credit_sales * 365",
      "guard": "If annual_credit_sales <= 0, return N/A"
    }
  ]
}